# Video-to-PDF-Guide-Creator — Environment Variables
# Copy this file to .env and fill in your values
# NEVER commit .env to GitHub

# ============================================================
# REQUIRED — App will not run without these
# ============================================================

# Anthropic Claude API key
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ============================================================
# REQUIRED FOR EMAIL — Add these to send PDF guides by email
# ============================================================

# Gmail address to send FROM
SMTP_EMAIL=region5dl@gmail.com

# Gmail App Password (16 characters, no spaces)
# How to create: myaccount.google.com → Security → 2-Step Verification → App Passwords
SMTP_PASSWORD=your_16_char_app_password_here

# ============================================================
# OPTIONAL — Webshare proxy for production transcript fetching
# ============================================================

WEBSHARE_PROXY_USERNAME=your_webshare_username
WEBSHARE_PROXY_PASSWORD=your_webshare_password
WEBSHARE_PROXY_URL=http://username-rotate:password@p.webshare.io:80/

# ============================================================
# OPTIONAL — App configuration
# ============================================================

CLAUDE_MODEL=claude-haiku-4-5-20251001
CLAUDE_MAX_TOKENS=2000
DEBUG=false
