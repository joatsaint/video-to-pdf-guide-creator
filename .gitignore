# Video-to-PDF-Guide-Creator — .gitignore
# Extends the GitHub Python template with project-specific exclusions

# ── Secrets — NEVER commit these ──────────────────────────────────────────────
.env
.env.local
.env.production

# ── Streamlit secrets ──────────────────────────────────────────────────────────
.streamlit/secrets.toml

# ── App-generated directories — runtime output, not source ───────────────────
logs/
generated_guides/
output/
sample_output/

# ── Python ────────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
*.egg-info/
dist/
build/
*.egg
*.pyc

# ── Virtual environment ────────────────────────────────────────────────────────
venv/
env/
.venv/
ENV/

# ── Testing ───────────────────────────────────────────────────────────────────
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/

# ── OS files ──────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini
*.swp
*.swo

# ── IDE ───────────────────────────────────────────────────────────────────────
.vscode/
.idea/
*.sublime-project
*.sublime-workspace

# ── Node (for future Next.js build) ───────────────────────────────────────────
node_modules/
.next/
.vercel/
npm-debug.log*

# ── Pre-commit ────────────────────────────────────────────────────────────────
.pre-commit-cache/
